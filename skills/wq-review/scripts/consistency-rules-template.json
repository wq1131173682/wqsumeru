{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "须弥写作 剧情一致性规则库",
  "description": "用于追踪和验证小说剧情一致性的规则库，包含人物状态、道具状态、伏笔、时间线等",
  "version": "1.0.0",
  
  "conflict_detection": {
    "description": "冲突检测规则，用于检测 state_diff 中的矛盾",
    "rules": [
      {
        "id": "unique_location",
        "description": "同一人物不能同时在两个地点",
        "severity": "critical",
        "on_conflict": "标记为critical issue，暂停写入，等待父Agent仲裁"
      },
      {
        "id": "destroyed_item_used",
        "description": "已毁道具不能再次使用",
        "severity": "critical",
        "on_conflict": "标记为critical issue，暂停写入，等待父Agent仲裁"
      },
      {
        "id": "foreshadowing_recycled",
        "description": "已标记回收的伏笔不能再次标记为active",
        "severity": "high",
        "on_conflict": "标记为high issue，记录到issues/"
      },
      {
        "id": "character_state_regression",
        "description": "人物状态不能无原因回退（如从重伤变回健康需有治疗情节）",
        "severity": "high",
        "on_conflict": "标记为high issue，检查是否有治疗情节"
      },
      {
        "id": "power_level_consistency",
        "description": "人物战力等级不能无原因跳跃（跳跃超过2级需有突破情节）",
        "severity": "medium",
        "on_conflict": "标记为medium issue，提醒检查"
      },
      {
        "id": "timeline_order",
        "description": "事件时间线必须有序",
        "severity": "high",
        "on_conflict": "标记为high issue，检查时间线"
      }
    ],
    "state_hierarchy": {
      "character_health": ["healthy", "minor_injury", "injured", "seriously_injured", "critical", "deceased"],
      "power_levels": ["凡人", "武者", "大师", "宗师", "宗师巅峰", "元婴", "化神", "炼虚", "合体", "大乘", "渡劫"]
    }
  },
  
